FROM ubuntu:jammy
LABEL maintainer="Gaiar Baimuratov <gaiar@baimuratov.ru>"

# Use different Ubuntu mirrors to avoid network issues
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://us.archive.ubuntu.com/ubuntu|g' /etc/apt/sources.list \
    && sed -i 's|http://security.ubuntu.com/ubuntu|http://security.ubuntu.com/ubuntu|g' /etc/apt/sources.list

RUN ln -fs /usr/share/zoneinfo/Europe/Berlin /etc/localtime
RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
	software-properties-common \
	python3-pip \
	python3.10-dev \
	python3.10-distutils \
	python3.10-venv \
        build-essential \
        cmake \
	ccache \
        git \
        wget \
        unzip \
        yasm \
        pkg-config \
        libswscale-dev \
        libtbb2 \
        libtbb-dev \
        libjpeg-turbo8-dev \
        libpng-dev \
        libtiff-dev \
        libavformat-dev \
        libpq-dev \
	libmkl-full-dev \
	firefox \
    && rm -rf /var/lib/apt/lists/*

# Install GeckoDriver manually
RUN GECKODRIVER_VERSION=0.34.0 \
    && wget -O /tmp/geckodriver.tar.gz "https://github.com/mozilla/geckodriver/releases/download/v${GECKODRIVER_VERSION}/geckodriver-v${GECKODRIVER_VERSION}-linux64.tar.gz" \
    && tar -xzf /tmp/geckodriver.tar.gz -C /usr/local/bin/ \
    && chmod +x /usr/local/bin/geckodriver \
    && rm /tmp/geckodriver.tar.gz

RUN pip3 install --no-cache-dir numpy selenium 

# Build OpenCV with proper cleanup in single layer
WORKDIR /
ENV OPENCV_VERSION="4.8.1"
RUN set -ex \
    && wget -O opencv.zip https://github.com/opencv/opencv/archive/${OPENCV_VERSION}.zip \
    && wget -O opencv_contrib.zip https://github.com/opencv/opencv_contrib/archive/${OPENCV_VERSION}.zip \
    && unzip opencv.zip \
    && unzip opencv_contrib.zip \
    && mkdir /opencv-${OPENCV_VERSION}/cmake_binary \
    && cd /opencv-${OPENCV_VERSION}/cmake_binary \
    && cmake -DBUILD_TIFF=ON \
      -DBUILD_opencv_java=OFF \
      -DOPENCV_EXTRA_MODULES_PATH=/opencv_contrib-${OPENCV_VERSION}/modules \
      -DWITH_CUDA=OFF \
      -DWITH_OPENGL=ON \
      -DWITH_OPENCL=ON \
      -DWITH_IPP=ON \
      -DWITH_TBB=ON \
      -DWITH_MKL=ON \
      -DMKL_USE_MULTITHREAD=ON \
      -DMKL_WITH_TBB=ON \
      -DWITH_EIGEN=ON \
      -DWITH_V4L=ON \
      -DBUILD_TESTS=OFF \
      -DBUILD_PERF_TESTS=OFF \
      -DCMAKE_BUILD_TYPE=RELEASE \
      -DCMAKE_INSTALL_PREFIX=$(python3.10 -c "import sys; print(sys.prefix)") \
      -DPYTHON_EXECUTABLE=$(which python3.10) \
      -DPYTHON_INCLUDE_DIR=$(python3.10 -c "from distutils.sysconfig import get_python_inc; print(get_python_inc())") \
      -DPYTHON_PACKAGES_PATH=$(python3.10 -c "from distutils.sysconfig import get_python_lib; print(get_python_lib())") \
      .. \
    && make install -j$(nproc) \
    && cd / \
    && rm -rf opencv.zip opencv_contrib.zip opencv-${OPENCV_VERSION} opencv_contrib-${OPENCV_VERSION} \
    && apt-get purge -y build-essential cmake wget unzip \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*
#RUN ln -s \
#  /usr/local/python/cv2/python-3.8/cv2.cpython-38-x86_64-linux-gnu.so \
#  /usr/local/lib/python3.8/site-packages/cv2.so
RUN ln -s \
	/usr/local/lib/python3.10/dist-packages/cv2.cpython-310-x86_64-linux-gnu.so \
	/usr/local/lib/python3.10/dist-packages/cv2.so
